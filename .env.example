# Environment Variables for Kaushal Setu (कौशल सेतु)
# MoSPI DIID / Smart India Hackathon 2026

# Database
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (Optional - Falls back to deterministic engine if unset)
GEMINI_API_KEY=""

# iGOT Karmayogi Enterprise Adapter (mock | live)
IGOT_API_MODE="mock"
IGOT_API_BASE_URL="https://igotkarmayogi.gov.in/api"
IGOT_CLIENT_ID=""
IGOT_CLIENT_SECRET=""

# National Single Sign-On (Parichay) Configuration
PARICHAY_SSO_MODE="mock"
PARICHAY_AUTH_URL="https://parichay.nic.in/pnv1/api"
